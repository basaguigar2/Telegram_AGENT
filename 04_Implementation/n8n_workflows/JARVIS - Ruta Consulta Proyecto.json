{
  "name": "JARVIS - Ruta Consulta Proyecto",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "usuario_id", "type": "string" },
            { "name": "chat_id", "type": "string" },
            { "name": "mensaje", "type": "string" }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "id": "rcons1ta-0001-4000-8000-000000000001",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const previo = $('When Executed by Another Workflow').first().json;\nconst m = previo.mensaje.toLowerCase();\nconst alias = {\n  'Levstamp': /levstamp|aptis|british council/,\n  'Tu Home Office': /tu home office|home office|afiliados amazon|amazon afiliados/,\n  'Wedding Planner Pro': /wedding planner|nuptial|boda|novios/,\n  'JARVIS': /\\bjarvis\\b/\n};\nlet nombre_proyecto = '';\nfor (const [nombre, patron] of Object.entries(alias)) {\n  if (patron.test(m)) { nombre_proyecto = nombre; break; }\n}\nreturn [{ json: { usuario_id: previo.usuario_id, chat_id: previo.chat_id, mensaje: previo.mensaje, nombre_proyecto, encontrado_por_palabra_clave: !!nombre_proyecto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0],
      "id": "rcons1ta-0010-4000-8000-000000000010",
      "name": "Detectar por palabra clave"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            { "id": "rcons1ta-0011-1", "leftValue": "={{ $json.encontrado_por_palabra_clave }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 0],
      "id": "rcons1ta-0011-4000-8000-000000000011",
      "name": "Coincide por palabra clave"
    },
    {
      "parameters": { "model": "llama3.2:3b", "options": { "temperature": 0 } },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [448, 260],
      "id": "rcons1ta-0002-4000-8000-000000000002",
      "name": "Ollama Model 1",
      "credentials": { "ollamaApi": { "id": "GIwMwr1pgXlWMDxU", "name": "Ollama account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.mensaje }}",
        "messages": {
          "messageValues": [
            { "message": "¿De cual de estos 4 proyectos habla el mensaje: \"Levstamp\", \"Tu Home Office\", \"Wedding Planner Pro\", \"JARVIS\"? Responde solo el nombre exacto entre los cuatro, o \"ninguno\" si no esta claro. Nada mas, sin explicacion." }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [224, 0],
      "id": "rcons1ta-0003-4000-8000-000000000003",
      "name": "Identificar proyecto"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const previo = $('When Executed by Another Workflow').first().json;\nconst raw = String($json.text ?? $json.response ?? $json.output ?? '').trim();\nlet nombre = raw.replace(/[\\\".]/g, '').trim();\nreturn [{ json: { usuario_id: previo.usuario_id, chat_id: previo.chat_id, mensaje: previo.mensaje, nombre_proyecto: nombre } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "id": "rcons1ta-0004-4000-8000-000000000004",
      "name": "Parsear nombre proyecto"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT atributos FROM mayordomo_entidades WHERE tipo = 'proyecto' AND nombre = $1 AND estado = 'activo' ORDER BY version DESC LIMIT 1;",
        "options": { "queryReplacement": "={{ [$json.nombre_proyecto] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [672, 0],
      "id": "rcons1ta-0005-4000-8000-000000000005",
      "name": "Leer proyecto",
      "alwaysOutputData": true,
      "credentials": { "postgres": { "id": "bPudOtymTMcJQME0", "name": "Postgres account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const previo = $('Detectar por palabra clave').first().json;\nconst fila = $json.atributos;\n\nfunction formatearValor(v) {\n  if (Array.isArray(v)) return v.join('; ');\n  return String(v);\n}\n\nlet datos = 'No hay datos guardados de este proyecto.';\nif (fila) {\n  datos = Object.entries(fila).map(([clave, valor]) => `${clave.replace(/_/g, ' ')}: ${formatearValor(valor)}`).join('\\n');\n}\n\nreturn [{ json: { usuario_id: previo.usuario_id, chat_id: previo.chat_id, mensaje: previo.mensaje, datos_proyecto: datos } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 0],
      "id": "rcons1ta-0006-4000-8000-000000000006",
      "name": "Armar datos"
    },
    {
      "parameters": { "model": "llama3.2:3b", "options": {} },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [1120, 160],
      "id": "rcons1ta-0007-4000-8000-000000000007",
      "name": "Ollama Model 2",
      "credentials": { "ollamaApi": { "id": "GIwMwr1pgXlWMDxU", "name": "Ollama account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Pregunta del usuario:\n{{ $json.mensaje }}\n\nDatos reales guardados del proyecto:\n{{ $json.datos_proyecto }}",
        "messages": {
          "messageValues": [
            { "message": "Responde la pregunta del usuario en español, de forma natural y breve, usando SOLO los datos que te doy. Si falta informacion para responder, dilo claramente en vez de inventar. No listes el JSON crudo, redacta la respuesta. Texto plano, SIN markdown, SIN asteriscos, SIN guiones bajos, SIN backticks, SIN simbolos de formato." }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [1120, 0],
      "id": "rcons1ta-0008-4000-8000-000000000008",
      "name": "Responder con datos"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const previo = $('Armar datos').first().json;\nconst texto = $json.text ?? $json.response ?? $json.output ?? '';\nconst limpio = String(texto).replace(/[*_`\\[\\]~]/g, '');\nreturn [{ json: { chat_id: previo.chat_id, texto_limpio: limpio } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1344, 0],
      "id": "rcons1ta-0010-4000-8000-00000000000a",
      "name": "Limpiar texto"
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.texto_limpio }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1568, 0],
      "id": "rcons1ta-0009-4000-8000-000000000009",
      "name": "Enviar respuesta",
      "credentials": { "telegramApi": { "id": "5ptxnruKOEoxb0K9", "name": "JARVIS BOT" } }
    }
  ],
