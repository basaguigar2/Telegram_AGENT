      "position": [672, 0],
      "id": "2b2b3c4d-0008-4000-8000-000000000008",
      "name": "Juntar"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const recuerdos = $('Recuerdos recientes').all().map(i => i.json);\nconst estadoHoy = $('Estado de hoy').all().map(i => i.json).filter(e => e.categoria);\nconst eventos = $('Eventos de hoy').all().map(i => i.json).filter(e => e.summary || e.id);\n\nlet notasClaude = '';\ntry {\n  const notaItem = $('Leer notas de Claude').first();\n  if (notaItem && notaItem.binary && notaItem.binary.data && notaItem.binary.data.data) {\n    notasClaude = Buffer.from(notaItem.binary.data.data, 'base64').toString('utf-8').trim();\n  }\n} catch (e) { /* no hay notas de Claude hoy, seguimos sin ellas */ }\n\nlet texto = `<b>Briefing diario</b>\\n\\n`;\n\nif (notasClaude) {\n  // La nota de Claude (rutina 6:30) ya trae resumen + propuesta de 3 niveles + recordatorios\n  // de hoy/manana + preguntas personales -- es el cuerpo principal del mensaje.\n  texto += `${notasClaude}\\n\\n`;\n} else {\n  // Respaldo simple si la rutina de las 6:30 todavia no ha corrido o fallo.\n  texto += `(Sin resumen de Claude todavia hoy.)\\n\\n`;\n  if (estadoHoy.length) {\n    texto += `Marcaste hoy: ${estadoHoy.map(e => e.contenido).join('; ')}. No te propongo tareas nuevas.\\n\\n`;\n  }\n  if (recuerdos.length) {\n    texto += `<b>Recordatorio de lo reciente</b>\\n`;\n    texto += recuerdos.slice(0, 5).map(r => `- [${r.categoria}] ${r.contenido}`).join('\\n');\n    texto += `\\n\\n`;\n  }\n}\n\nif (eventos.length) {\n  texto += `<b>Hoy en el calendario (${eventos.length})</b>\\n`;\n  texto += eventos.slice(0, 5).map(e => `- ${e.summary || '(sin titulo)'}`).join('\\n');\n}\n\nreturn [{ json: { texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 0],
      "id": "2b2b3c4d-0006-4000-8000-000000000006",
      "name": "Armar briefing"
    },
