      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rutas = $input.all().map(i => i.json).filter(r => r.ruta_id);\nconst criteria = {};\nfor (const r of rutas) { criteria[r.ruta_id] = r.descripcion; }\nconst mensaje = $('Telegram Trigger').item.json.message.text;\nconst body = {\n  model: 'jev-latest',\n  state: 'Mensaje del usuario: ' + mensaje,\n  questions: {\n    ruta: {\n      type: 'choice',\n      instructions: 'Cual de estas rutas describe mejor el mensaje?',\n      criteria\n    },\n    necesita_revision_humana: { type: 'noul', instructions: 'La confianza es baja o el caso es ambiguo?' }\n  }\n};\nreturn [{ json: { jev_body: body } }];"
      },
